# Telegram bot token from @BotFather
TG_TOKEN=your_token_here

# Path to the SQLite database file.
# Locally leave default; in Docker use the mounted volume.
DB_PATH=messages.db

# Directory where captured media is stored (mounted as a volume in Docker).
MEDIA_DIR=media

# --- Admin panel (in-bot, password login) ---
# Password for /admin <password>. Keep it secret, never commit the real .env.
ADMIN_PASSWORD=change_me
# Comma-separated user_ids allowed to even attempt admin login (sanity-check).
ADMIN_IDS=123456789

# Username (without @) the «Support» button opens a chat with.
SUPPORT_USERNAME=support

# --- Monitoring (optional) ---
# If set, the bot periodically pings this URL so an external uptime monitor
# (UptimeRobot / Healthchecks.io) can alert you when the bot goes down.
HEALTHCHECK_URL=

# --- YooKassa payments (optional until enabled) ---
# Shop id and secret key from https://yookassa.ru/my. Until set, the «buy»
# flow shows "payment coming soon" and only the free /trial works.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
